# Copy to /opt/MB/.env on the server (chmod 600). Never commit the real file.
# One token per Business Manager (BM1, BM2, BM3 = the groups used in accounts.json -> token_env).
# put the same token in all three.
META_TOKEN_BM1=
META_TOKEN_BM2=
META_TOKEN_BM3=
META_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ANTHROPIC_API_KEY=

# optional: n8n webhook -> WhatsApp / Slack / Email
MBOS_WEBHOOK_URL=
